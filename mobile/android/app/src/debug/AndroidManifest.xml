<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- debug เท่านั้น: อนุญาต cleartext HTTP ให้ฝั่ง native (HttpURLConnection ใน LocationHelper)
         คุยกับ backend dev (http://10.0.2.2:3001) ได้ — Android 9+ บล็อก cleartext โดย default
         (ฝั่ง Dart ไม่โดนบล็อกอยู่แล้ว จึงเห็นเฉพาะ native เงียบ) release ไม่ได้รับผลนี้ -->
    <application android:usesCleartextTraffic="true" tools:targetApi="23"/>
</manifest>
