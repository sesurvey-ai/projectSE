<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9">

    <!-- Center section: title + logo + ชื่อบริษัท + การ์ดสถานที่ (จัดกึ่งกลาง) -->
    <LinearLayout
        android:id="@+id/top_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_centerInParent="true"
        android:layout_marginBottom="64dp"
        android:paddingHorizontal="32dp">

        <!-- Title (อยู่บนโลโก้) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="งานสำรวจใหม่"
            android:textSize="32sp"
            android:textColor="#1A2733"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- โลโก้บริษัทประกัน (แสดงตามบริษัทในเคส) -->
        <ImageView
            android:id="@+id/img_logo"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="company logo"
            android:visibility="gone" />

        <!-- ชื่อย่อบริษัทประกัน (ใต้โลโก้) -->
        <TextView
            android:id="@+id/txt_insurance_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="18sp"
            android:textColor="#1A2733"
            android:textStyle="bold"
            android:layout_marginBottom="22dp" />

        <!-- Info card: สถานที่เกิดเหตุ + เลขเคลม -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg_light"
            android:padding="20dp">

            <!-- สถานที่เกิดเหตุ (แสดงเต็ม ไม่ตัด) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="2dp"
                    android:src="@android:drawable/ic_menu_compass"
                    android:tint="#FF9800"
                    android:contentDescription="location" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="สถานที่เกิดเหตุ"
                        android:textSize="12sp"
                        android:textColor="#64748B" />

                    <TextView
                        android:id="@+id/txt_incident"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="#1A2733" />
                </LinearLayout>
            </LinearLayout>

            <!-- เลขเคลม — ส่งมากับแจ้งเตือนอยู่แล้วแต่เดิมไม่ได้แสดง (user 31/08/69)
                 ทั้งบล็อกซ่อนเมื่อไม่มีเลข: เส้นคั่นลอยอยู่เฉย ๆ ดูเหมือนจอค้าง -->
            <LinearLayout
                android:id="@+id/row_claim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="2dp"
                        android:src="@android:drawable/ic_menu_agenda"
                        android:tint="#FF9800"
                        android:contentDescription="claim number" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="เลขเคลม"
                            android:textSize="12sp"
                            android:textColor="#64748B" />

                        <TextView
                            android:id="@+id/txt_claim_no"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textColor="#1A2733" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:paddingHorizontal="40dp"
        android:paddingBottom="80dp">

        <Button
            android:id="@+id/btn_accept"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="รับงาน"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/btn_accept_fullscreen"
            android:textAllCaps="false" />
    </LinearLayout>

</RelativeLayout>
